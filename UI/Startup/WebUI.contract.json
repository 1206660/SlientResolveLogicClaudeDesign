{
  "version": 1,
  "templates": [
    { "id": "Default", "directory": "Content/CoreLogic/UI/Startup/WebLogin", "label": "默认 · 楷墨" },
    { "id": "Ink", "directory": "Content/CoreLogic/UI/Startup/WebLogin_Ink", "label": "水墨 · Ink" }
  ],
  "pages": [
    { "pageId": "boot", "html": "boot.html", "setter": "setBootData", "namespace": "SRBoot", "surface": "startup-web-boot", "kind": "splash" },
    { "pageId": "login", "html": "index.html", "setter": "setStartupData", "namespace": "SRLogin", "surface": "startup-web-login", "kind": "fullscreen-menu" },
    { "pageId": "settings", "html": "settings.html", "setter": "setSettingsData", "namespace": "SRSettings", "surface": "startup-web-settings", "kind": "fullscreen-menu" },
    { "pageId": "skills", "html": "skills.html", "setter": "setSkillsData", "namespace": "SRSkills", "surface": "startup-web-skills", "kind": "fullscreen-menu" },
    { "pageId": "inventory", "html": "inventory.html", "setter": "setInventoryData", "namespace": "SRInventory", "surface": "startup-web-inventory", "kind": "fullscreen-menu" },
    { "pageId": "journal", "html": "journal.html", "setter": "setJournalData", "namespace": "SRJournal", "surface": "startup-web-journal", "kind": "fullscreen-menu" },
    { "pageId": "dialogue", "html": "dialogue.html", "setter": "setDialogueData", "namespace": "SRDialogue", "surface": "startup-web-dialogue", "kind": "narrative" },
    { "pageId": "load", "html": "load.html", "setter": "setLoadData", "namespace": "SRLoad", "surface": "startup-web-load", "kind": "fullscreen-menu" },
    { "pageId": "combat", "html": "combat.html", "setter": "setCombatData", "namespace": "SRCombat", "surface": "startup-web-combat", "kind": "transparent-hud" },
    { "pageId": "cinematic", "html": "cinematic.html", "setter": "setCinematicData", "namespace": "SRCinematic", "surface": "startup-web-cinematic", "kind": "narrative" },
    { "pageId": "pause", "html": "pause.html", "setter": "setPauseData", "namespace": "SRPause", "surface": "startup-web-pause", "kind": "modal" },
    { "pageId": "map", "html": "map.html", "setter": "setMapData", "namespace": "SRMap", "surface": "startup-web-map", "kind": "fullscreen-menu" },
    { "pageId": "codex", "html": "codex.html", "setter": "setCodexData", "namespace": "SRCodex", "surface": "startup-web-codex", "kind": "fullscreen-menu" },
    { "pageId": "profile", "html": "profile.html", "setter": "setProfileData", "namespace": "SRProfile", "surface": "startup-web-profile", "kind": "fullscreen-menu" },
    { "pageId": "lobby", "html": "lobby.html", "setter": "setLobbyData", "namespace": "SRLobby", "surface": "startup-web-lobby", "kind": "fullscreen-menu" }
  ],
  "events": {
    "lifecycle": ["ready", "back", "nav"],
    "commands": ["commit", "apply", "reset", "change"],
    "dialogue": ["dialogue.advance", "dialogue.choice", "dialogue.skip", "dialogue.backlog", "dialogue.abort"],
    "naming": "Use page.action for page-specific events, for example inventory.useItem or map.travel."
  },
  "dialogue": {
    "setter": "setDialogueData",
    "payload": {
      "dialogueId":  "string — globally unique dialogue id, matches Runtime/CH*-*.json Dialogue.id",
      "title":       "string — human-readable dialogue title",
      "archetype":   "string — ambient_walkby | narration_cutscene | choice_response | combat_bark | social_schedule",
      "progression": "string — Auto | TextBased | Custom",
      "nodeId":      "string — current node id within the dialogue",
      "nodeType":    "string — say | choice | branch | end",
      "nodeIndex":   "int32  — 0-based position within the dialogue's nodes array",
      "nodeCount":   "int32  — total number of nodes in the dialogue",
      "speakerId":   "string — participant.id; empty for narrator-only nodes",
      "speaker":     "string — speaker display name resolved by Runtime",
      "portrait":    "string — portrait override asset path; empty when default profile portrait should be used",
      "text":        "string — node body, with {{variable}} substitutions resolved",
      "subtitleDurationSeconds": "number — recommended display duration; 0 = TextBased pacing",
      "cameraPreset":      "string — camera preset id for cue dispatcher",
      "postProcessPreset": "string — pp preset id for cue dispatcher",
      "surface":     "string — always 'startup-web-dialogue' for M2",
      "choices":     "FSRDialogueChoice[] when nodeType='choice'; each: { id, text, enabled, conditionDisplayMode? }"
    },
    "incoming": {
      "dialogue.advance": "{ } — advance one node (Say next; ignored on Choice)",
      "dialogue.choice":  "{ choiceId: string, choiceIndex?: int }",
      "dialogue.skip":    "{ } — fast-forward typewriter / auto timer",
      "dialogue.backlog": "{ open: bool }                       — UI-only overlay request, no runtime state change",
      "dialogue.abort":   "{ } — player closed the dialogue surface"
    }
  }
}
